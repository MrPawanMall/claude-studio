{
  "name": "claude-studio",
  "displayName": "Claude Studio by PM",
  "description": "All-in-one companion for the Claude agent: auto-open edited files, review diffs, undo tasks, built-in SFTP/FTP upload, usage & cost tracker, skills manager and notifications with sounds.",
  "version": "2.0.1",
  "publisher": "pawanmall",
  "author": {
    "name": "Pawan Mall",
    "email": "pawan.webmaster@gmail.com",
    "url": "https://www.pawanmall.in"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1B2E",
    "theme": "dark"
  },
  "homepage": "https://webdevservices.in/claude-studio-vs-code-extension/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrPawanMall/claude-studio.git"
  },
  "bugs": {
    "url": "https://github.com/MrPawanMall/claude-studio/issues",
    "email": "pawan.webmaster@gmail.com"
  },
  "qna": "https://github.com/MrPawanMall/claude-studio/discussions",
  "pricing": "Free",
  "sponsor": {
    "url": "https://www.webdevservices.in/"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai agent",
    "antigravity",
    "auto open",
    "diff",
    "undo",
    "sftp",
    "ftp",
    "upload",
    "usage",
    "cost",
    "skills",
    "notifications",
    "php"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted folders Claude Studio still opens and tracks Claude's edits, but server uploads, PHP checks, live reload and project skill installs stay off until you trust the folder.",
      "restrictedConfigurations": [
        "claudeStudio.upload.claudeEdits",
        "claudeStudio.upload.confirmProfiles",
        "claudeStudio.liveReload.enabled",
        "claudeStudio.liveReload.port",
        "claudeStudio.liveReload.watch"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeStudio.autoOpen.menu",
        "title": "Quick Menu",
        "category": "Claude Studio",
        "icon": "$(eye)"
      },
      {
        "command": "claudeStudio.autoOpen.toggle",
        "title": "Turn Auto-Open On/Off",
        "category": "Claude Studio"
      },
      {
        "command": "claudeStudio.autoOpen.toggleProject",
        "title": "Turn Auto-Open On/Off for This Project",
        "category": "Claude Studio"
      },
      {
        "command": "claudeStudio.autoOpen.pause",
        "title": "Pause Auto-Open…",
        "category": "Claude Studio",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claudeStudio.autoOpen.resume",
        "title": "Resume Auto-Open",
        "category": "Claude Studio",
        "icon": "$(debug-continue)"
      },
      {
        "command": "claudeStudio.autoOpen.closeOpenedTabs",
        "title": "Close Tabs Opened by Claude Studio",
        "category": "Claude Studio",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeStudio.changes.diff",
        "title": "Show What Claude Changed",
        "category": "Claude Studio",
        "icon": "$(diff)"
      },
      {
        "command": "claudeStudio.changes.diffTask",
        "title": "Show All Changes Since Task Start",
        "category": "Claude Studio",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeStudio.changes.undo",
        "title": "Undo Claude's Edit to This File",
        "category": "Claude Studio",
        "icon": "$(discard)"
      },
      {
        "command": "claudeStudio.changes.revertTask",
        "title": "Undo Whole Claude Task",
        "category": "Claude Studio",
        "icon": "$(history)"
      },
      {
        "command": "claudeStudio.changes.checkpoint",
        "title": "Create Checkpoint",
        "category": "Claude Studio",
        "icon": "$(bookmark)"
      },
      {
        "command": "claudeStudio.changes.revertCheckpoint",
        "title": "Revert to Checkpoint",
        "category": "Claude Studio",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "claudeStudio.changes.deleteCheckpoint",
        "title": "Delete Checkpoint",
        "category": "Claude Studio",
        "icon": "$(trash)"
      },
      {
        "command": "claudeStudio.changes.copySummary",
        "title": "Copy Task Summary",
        "category": "Claude Studio",
        "icon": "$(copy)"
      },
      {
        "command": "claudeStudio.changes.markReviewed",
        "title": "Mark as Reviewed",
        "category": "Claude Studio",
        "icon": "$(check)"
      },
      {
        "command": "claudeStudio.changes.markAllReviewed",
        "title": "Mark All as Reviewed",
        "category": "Claude Studio",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeStudio.changes.clear",
        "title": "Clear Change History",
        "category": "Claude Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeStudio.changes.uploadTask",
        "title": "Upload Task's Files",
        "category": "Claude Studio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeStudio.upload.file",
        "title": "Upload to Server",
        "category": "Claude Studio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeStudio.upload.download",
        "title": "Download from Server",
        "category": "Claude Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeStudio.upload.compare",
        "title": "Compare with Server",
        "category": "Claude Studio",
        "icon": "$(diff)"
      },
      {
        "command": "claudeStudio.upload.switchProfile",
        "title": "Switch Server Profile",
        "category": "Claude Studio",
        "icon": "$(server-environment)"
      },
      {
        "command": "claudeStudio.upload.createConfig",
        "title": "Set Up Server (sftp.json)",
        "category": "Claude Studio",
        "icon": "$(add)"
      },
      {
        "command": "claudeStudio.upload.openConfig",
        "title": "Open sftp.json",
        "category": "Claude Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeStudio.upload.movePasswords",
        "title": "Move Passwords to Secure Storage",
        "category": "Claude Studio",
        "icon": "$(lock)"
      },
      {
        "command": "claudeStudio.upload.forgetPassword",
        "title": "Forget Saved Server Password",
        "category": "Claude Studio",
        "icon": "$(key)"
      },
      {
        "command": "claudeStudio.upload.forgetHostKey",
        "title": "Forget Server Key",
        "category": "Claude Studio"
      },
      {
        "command": "claudeStudio.upload.retry",
        "title": "Retry Upload",
        "category": "Claude Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStudio.upload.retryFailed",
        "title": "Retry Failed Uploads",
        "category": "Claude Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStudio.upload.clear",
        "title": "Clear Upload History",
        "category": "Claude Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeStudio.usage.dashboard",
        "title": "Open Usage Dashboard",
        "category": "Claude Studio",
        "icon": "$(dashboard)"
      },
      {
        "command": "claudeStudio.usage.refresh",
        "title": "Refresh Usage",
        "category": "Claude Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStudio.usage.enablePlanLimits",
        "title": "Show 5h / 7d Plan Usage",
        "category": "Claude Studio",
        "icon": "$(eye)"
      },
      {
        "command": "claudeStudio.skills.browse",
        "title": "Browse Skills…",
        "category": "Claude Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeStudio.skills.addSource",
        "title": "Add Skill Source…",
        "category": "Claude Studio",
        "icon": "$(add)"
      },
      {
        "command": "claudeStudio.skills.removeSource",
        "title": "Remove Skill Source",
        "category": "Claude Studio",
        "icon": "$(trash)"
      },
      {
        "command": "claudeStudio.skills.create",
        "title": "Create New Skill…",
        "category": "Claude Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "claudeStudio.skills.toggle",
        "title": "Enable / Disable Skill",
        "category": "Claude Studio",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeStudio.skills.remove",
        "title": "Delete Skill",
        "category": "Claude Studio",
        "icon": "$(trash)"
      },
      {
        "command": "claudeStudio.skills.reveal",
        "title": "Reveal Skill Folder",
        "category": "Claude Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeStudio.skills.checkUpdates",
        "title": "Check Skills for Updates",
        "category": "Claude Studio",
        "icon": "$(sync)"
      },
      {
        "command": "claudeStudio.skills.setGithubToken",
        "title": "Set GitHub Token for Skills",
        "category": "Claude Studio",
        "icon": "$(key)"
      },
      {
        "command": "claudeStudio.skills.installZip",
        "title": "Install Skill from .zip File…",
        "category": "Claude Studio",
        "icon": "$(file-zip)"
      },
      {
        "command": "claudeStudio.skills.refresh",
        "title": "Refresh Skills",
        "category": "Claude Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeStudio.notifications.clear",
        "title": "Clear Notifications",
        "category": "Claude Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeStudio.notifications.markAllRead",
        "title": "Mark Notifications Read",
        "category": "Claude Studio",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeStudio.notifications.chooseSound",
        "title": "Change Notification Sounds…",
        "category": "Claude Studio",
        "icon": "$(unmute)"
      },
      {
        "command": "claudeStudio.notifications.testSound",
        "title": "Test Notification Sound",
        "category": "Claude Studio",
        "icon": "$(play)"
      },
      {
        "command": "claudeStudio.notifications.resetSounds",
        "title": "Reset Sounds to Default",
        "category": "Claude Studio",
        "icon": "$(discard)"
      },
      {
        "command": "claudeStudio.notifications.toggleDnd",
        "title": "Do Not Disturb On/Off",
        "category": "Claude Studio",
        "icon": "$(bell-slash)"
      },
      {
        "command": "claudeStudio.notifications.runAction",
        "title": "Open Notification",
        "category": "Claude Studio"
      },
      {
        "command": "claudeStudio.liveReload.copySnippet",
        "title": "Copy Live Reload Script Tag",
        "category": "Claude Studio",
        "icon": "$(copy)"
      },
      {
        "command": "claudeStudio.openSettings",
        "title": "Settings",
        "category": "Claude Studio",
        "icon": "$(gear)"
      },
      {
        "command": "claudeStudio.showLog",
        "title": "Show Log",
        "category": "Claude Studio",
        "icon": "$(output)"
      },
      {
        "command": "claudeStudio.about",
        "title": "About Claude Studio by PM",
        "category": "Claude Studio",
        "icon": "$(info)"
      },
      {
        "command": "claudeStudio.changes.openFile",
        "title": "Open File",
        "category": "Claude Studio",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeStudio.notifications.runAction",
          "when": "false"
        },
        {
          "command": "claudeStudio.changes.openFile",
          "when": "false"
        },
        {
          "command": "claudeStudio.changes.deleteCheckpoint",
          "when": "false"
        },
        {
          "command": "claudeStudio.upload.retry",
          "when": "false"
        },
        {
          "command": "claudeStudio.skills.toggle",
          "when": "false"
        },
        {
          "command": "claudeStudio.skills.remove",
          "when": "false"
        },
        {
          "command": "claudeStudio.skills.reveal",
          "when": "false"
        },
        {
          "command": "claudeStudio.skills.removeSource",
          "when": "false"
        },
        {
          "command": "claudeStudio.upload.file",
          "when": "workspaceTrusted"
        },
        {
          "command": "claudeStudio.upload.download",
          "when": "workspaceTrusted"
        },
        {
          "command": "claudeStudio.upload.compare",
          "when": "workspaceTrusted"
        }
      ],
      "view/title": [
        {
          "command": "claudeStudio.changes.checkpoint",
          "when": "view == claudeStudio.changes",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.changes.markAllReviewed",
          "when": "view == claudeStudio.changes",
          "group": "navigation@2"
        },
        {
          "command": "claudeStudio.autoOpen.menu",
          "when": "view == claudeStudio.changes",
          "group": "navigation@3"
        },
        {
          "command": "claudeStudio.changes.clear",
          "when": "view == claudeStudio.changes",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.autoOpen.closeOpenedTabs",
          "when": "view == claudeStudio.changes",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.about",
          "when": "view == claudeStudio.changes",
          "group": "3_about"
        },
        {
          "command": "claudeStudio.upload.retryFailed",
          "when": "view == claudeStudio.uploads",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.upload.switchProfile",
          "when": "view == claudeStudio.uploads",
          "group": "navigation@2"
        },
        {
          "command": "claudeStudio.upload.openConfig",
          "when": "view == claudeStudio.uploads",
          "group": "navigation@3"
        },
        {
          "command": "claudeStudio.upload.clear",
          "when": "view == claudeStudio.uploads",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.upload.movePasswords",
          "when": "view == claudeStudio.uploads",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.upload.forgetPassword",
          "when": "view == claudeStudio.uploads",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.upload.forgetHostKey",
          "when": "view == claudeStudio.uploads",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.usage.refresh",
          "when": "view == claudeStudio.usage",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.usage.dashboard",
          "when": "view == claudeStudio.usage",
          "group": "navigation@2"
        },
        {
          "command": "claudeStudio.skills.browse",
          "when": "view == claudeStudio.skills",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.skills.create",
          "when": "view == claudeStudio.skills",
          "group": "navigation@2"
        },
        {
          "command": "claudeStudio.skills.refresh",
          "when": "view == claudeStudio.skills",
          "group": "navigation@3"
        },
        {
          "command": "claudeStudio.skills.addSource",
          "when": "view == claudeStudio.skills",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.skills.installZip",
          "when": "view == claudeStudio.skills",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.skills.checkUpdates",
          "when": "view == claudeStudio.skills",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.skills.setGithubToken",
          "when": "view == claudeStudio.skills",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.notifications.markAllRead",
          "when": "view == claudeStudio.notifications",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.notifications.clear",
          "when": "view == claudeStudio.notifications",
          "group": "navigation@2"
        },
        {
          "command": "claudeStudio.notifications.toggleDnd",
          "when": "view == claudeStudio.notifications",
          "group": "navigation@3"
        },
        {
          "command": "claudeStudio.notifications.chooseSound",
          "when": "view == claudeStudio.notifications",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.notifications.testSound",
          "when": "view == claudeStudio.notifications",
          "group": "2_more"
        },
        {
          "command": "claudeStudio.notifications.resetSounds",
          "when": "view == claudeStudio.notifications",
          "group": "2_more"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeStudio.changes.diff",
          "when": "view == claudeStudio.changes && viewItem == changeFile",
          "group": "inline@1"
        },
        {
          "command": "claudeStudio.changes.undo",
          "when": "view == claudeStudio.changes && viewItem =~ /^changeFile/",
          "group": "inline@3"
        },
        {
          "command": "claudeStudio.upload.file",
          "when": "view == claudeStudio.changes && viewItem =~ /^changeFile/ && claudeStudio.hasUploadConfig",
          "group": "inline@2"
        },
        {
          "command": "claudeStudio.changes.openFile",
          "when": "view == claudeStudio.changes && viewItem =~ /^changeFile/",
          "group": "1_open@1"
        },
        {
          "command": "claudeStudio.changes.diffTask",
          "when": "view == claudeStudio.changes && viewItem == changeFile",
          "group": "1_open@2"
        },
        {
          "command": "claudeStudio.changes.markReviewed",
          "when": "view == claudeStudio.changes && viewItem =~ /^changeFile|task/",
          "group": "2_review"
        },
        {
          "command": "claudeStudio.changes.revertTask",
          "when": "view == claudeStudio.changes && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "claudeStudio.changes.copySummary",
          "when": "view == claudeStudio.changes && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "claudeStudio.changes.uploadTask",
          "when": "view == claudeStudio.changes && viewItem == task && claudeStudio.hasUploadConfig",
          "group": "3_upload"
        },
        {
          "command": "claudeStudio.changes.revertCheckpoint",
          "when": "view == claudeStudio.changes && viewItem == checkpoint",
          "group": "inline@1"
        },
        {
          "command": "claudeStudio.changes.deleteCheckpoint",
          "when": "view == claudeStudio.changes && viewItem == checkpoint",
          "group": "inline@2"
        },
        {
          "command": "claudeStudio.upload.retry",
          "when": "view == claudeStudio.uploads && viewItem == uploadFailed",
          "group": "inline"
        },
        {
          "command": "claudeStudio.upload.compare",
          "when": "view == claudeStudio.uploads && viewItem =~ /^upload/",
          "group": "1_actions"
        },
        {
          "command": "claudeStudio.upload.download",
          "when": "view == claudeStudio.uploads && viewItem =~ /^upload/",
          "group": "1_actions"
        },
        {
          "command": "claudeStudio.upload.switchProfile",
          "when": "view == claudeStudio.uploads && viewItem == server",
          "group": "inline"
        },
        {
          "command": "claudeStudio.skills.toggle",
          "when": "view == claudeStudio.skills && viewItem =~ /^skill(Tracked|Disabled)?$/",
          "group": "inline@1"
        },
        {
          "command": "claudeStudio.skills.remove",
          "when": "view == claudeStudio.skills && viewItem =~ /^skill(Tracked|Disabled)?$/",
          "group": "inline@2"
        },
        {
          "command": "claudeStudio.skills.reveal",
          "when": "view == claudeStudio.skills && viewItem =~ /^skill(Tracked|Disabled)?$/",
          "group": "1_actions"
        },
        {
          "command": "claudeStudio.skills.removeSource",
          "when": "view == claudeStudio.skills && viewItem == skillSource",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "claudeStudio.changes.diff",
          "when": "resourceScheme == file && resourcePath in claudeStudio.changedFiles",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeStudio.upload.file",
          "when": "resourceScheme == file && claudeStudio.hasUploadConfig",
          "group": "claudeStudio"
        }
      ],
      "editor/context": [
        {
          "command": "claudeStudio.changes.diff",
          "when": "resourceScheme == file && resourcePath in claudeStudio.changedFiles",
          "group": "claudeStudio@1"
        },
        {
          "command": "claudeStudio.changes.undo",
          "when": "resourceScheme == file && resourcePath in claudeStudio.changedFiles",
          "group": "claudeStudio@2"
        },
        {
          "command": "claudeStudio.upload.file",
          "when": "resourceScheme == file && claudeStudio.hasUploadConfig",
          "group": "claudeStudio@3"
        },
        {
          "command": "claudeStudio.upload.compare",
          "when": "resourceScheme == file && claudeStudio.hasUploadConfig",
          "group": "claudeStudio@4"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeStudio.upload.file",
          "when": "claudeStudio.hasUploadConfig",
          "group": "claudeStudio@1"
        },
        {
          "command": "claudeStudio.upload.download",
          "when": "!explorerResourceIsFolder && claudeStudio.hasUploadConfig",
          "group": "claudeStudio@2"
        },
        {
          "command": "claudeStudio.upload.compare",
          "when": "!explorerResourceIsFolder && claudeStudio.hasUploadConfig",
          "group": "claudeStudio@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeStudio",
          "title": "Claude Studio",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "claudeStudio": [
        {
          "id": "claudeStudio.changes",
          "name": "Changes",
          "icon": "media/activity.svg"
        },
        {
          "id": "claudeStudio.uploads",
          "name": "Uploads"
        },
        {
          "id": "claudeStudio.usage",
          "name": "Usage"
        },
        {
          "id": "claudeStudio.skills",
          "name": "Skills"
        },
        {
          "id": "claudeStudio.notifications",
          "name": "Notifications",
          "visibility": "collapsed"
        }
      ]
