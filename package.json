    "viewsWelcome": [
      {
        "view": "claudeStudio.changes",
        "contents": "Files Claude edits will show up here, grouped by task, with diff and undo.\n[$(bookmark) Create Checkpoint](command:claudeStudio.changes.checkpoint)\nTip: create a checkpoint before a big task so you can undo everything in one click.\n[$(info) About Claude Studio by PM](command:claudeStudio.about)"
      },
      {
        "view": "claudeStudio.uploads",
        "contents": "Upload files to your server over SFTP or FTP. Claude Studio reads `.vscode/sftp.json` (same format as the SFTP extension).\n[$(add) Set Up Server](command:claudeStudio.upload.createConfig)",
        "when": "!claudeStudio.hasUploadConfig"
      }
    ],
    "configuration": {
      "title": "Claude Studio by PM",
      "properties": {
        "claudeStudio.autoOpen.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open files automatically when the Claude agent edits or creates them."
        },
        "claudeStudio.autoOpen.openNewFiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also open new files Claude creates."
        },
        "claudeStudio.autoOpen.preserveFocus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep the cursor in the Claude chat while files open."
        },
        "claudeStudio.autoOpen.preview": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open as a preview tab (each new file replaces the last one)."
        },
        "claudeStudio.autoOpen.highlightChanges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Flash the changed lines when a file opens."
        },
        "claudeStudio.autoOpen.highlightDurationMs": {
          "type": "number",
          "default": 4000,
          "markdownDescription": "How long the flash lasts (milliseconds).",
          "minimum": 500,
          "maximum": 30000
        },
        "claudeStudio.autoOpen.scrollToChange": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll to the first changed line."
        },
        "claudeStudio.autoOpen.keepMarkersUntilReviewed": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep a green bar beside changed lines until you review the file (open its diff, edit it, or mark it reviewed)."
        },
        "claudeStudio.autoOpen.maxOpenTabs": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Close older tabs Claude Studio opened when there are more than this many. `0` = no limit.",
          "minimum": 0,
          "maximum": 100
        },
        "claudeStudio.autoOpen.formatAfterEdit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run your formatter on files Claude edits, then save them."
        },
        "claudeStudio.autoOpen.debounceMs": {
          "type": "number",
          "default": 300,
          "markdownDescription": "Wait this long after a change before handling it, so rapid writes are grouped.",
          "minimum": 50,
          "maximum": 5000
        },
        "claudeStudio.autoOpen.maxFilesPerBurst": {
          "type": "number",
          "default": 5,
          "markdownDescription": "If more files than this change at once (git checkout, composer/npm install, builds), they are ignored.",
          "minimum": 1,
          "maximum": 200
        },
        "claudeStudio.autoOpen.exclude": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/vendor/**",
            "**/writable/**",
            "**/storage/**",
            "**/application/cache/**",
            "**/application/logs/**",
            "**/dist/**",
            "**/build/**",
            "**/*.log",
            "**/*.lock",
            "**/.claude/**",
            "**/.vscode/**"
          ],
          "markdownDescription": "Files Claude Studio never tracks or opens (glob patterns).",
          "items": {
            "type": "string"
          }
        },
        "claudeStudio.changes.clickOpensDiff": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Clicking a file in the Changes panel shows the before/after diff (instead of just opening the file)."
        },
        "claudeStudio.notifications.taskFinished": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification when Claude finishes a task."
        },
        "claudeStudio.notifications.finishedAfterSeconds": {
          "type": "number",
          "default": 8,
          "markdownDescription": "A task counts as finished when Claude hasn't changed any file for this many seconds.",
          "minimum": 2,
          "maximum": 300
        },
        "claudeStudio.notifications.toasts": {
          "type": "string",
          "default": "all",
          "markdownDescription": "Which notifications pop up. All of them are always kept in the Notifications panel.",
          "enum": [
            "all",
            "important",
            "errors",
            "none"
          ],
          "enumDescriptions": [
            "Every notification",
            "Success, warnings and errors",
            "Only errors",
            "Never pop up (panel only)"
          ]
        },
        "claudeStudio.notifications.doNotDisturb": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "No pop-ups and no sounds. Notifications are still saved in the panel."
        },
        "claudeStudio.sound.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Play sounds for notifications."
        },
        "claudeStudio.sound.volume": {
          "type": "number",
          "default": 70,
          "markdownDescription": "Sound volume (0–100).",
          "minimum": 0,
          "maximum": 100
        },
        "claudeStudio.sound.taskFinished": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **Claude finished a task**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `chime`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.uploadSuccess": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **an upload finished**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `none`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.uploadFailed": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **an upload failed**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `error`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.lintError": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **a PHP syntax error is found**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `error`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.budgetAlert": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **a budget alert fires**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `alert`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.rateLimitAlert": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **usage nears your plan limit**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `alert`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.sound.skillInstalled": {
          "type": "string",
          "default": "",
          "markdownDescription": "Sound when **a skill is installed**. Use `chime`, `success`, `error`, `alert`, `pop`, `bell`, `none`, or the full path to your own `.wav` / `.mp3` file. Easiest: run **Claude Studio: Change Notification Sounds…**. Default: `pop`.",
          "scope": "machine-overridable"
        },
        "claudeStudio.php.lintAfterClaudeEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run `php -l` on every PHP file Claude edits and show syntax errors in the Problems panel."
        },
        "claudeStudio.php.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `php` / `php.exe` (for example `C:\\\\xampp\\\\php\\\\php.exe`). Empty = use `php` from PATH.",
          "scope": "machine"
        },
        "claudeStudio.upload.claudeEdits": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "What to do with files Claude edits when the project has a `.vscode/sftp.json`.",
          "enum": [
            "auto",
            "afterTask",
            "ask",
            "off"
          ],
          "enumDescriptions": [
            "Upload each file as soon as Claude finishes writing it",
            "Upload all files together when Claude finishes the task",
            "Show an Upload button in the 'Claude finished' notification",
            "Never upload Claude's edits automatically"
          ]
        },
        "claudeStudio.upload.confirmProfiles": {
          "type": "array",
          "default": [
            "prod",
            "production",
            "live"
          ],
          "markdownDescription": "Profiles (or server names containing these words) that always ask before uploading.",
          "items": {
            "type": "string"
          }
        },
        "claudeStudio.upload.blockPhpErrors": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Don't upload a PHP file that has a syntax error."
        },
        "claudeStudio.upload.uploadAfterRevert": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After undoing Claude's changes, upload the restored files too."
        },
        "claudeStudio.upload.notifyOnSuccess": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show a notification after every successful upload (otherwise only the status bar shows it)."
        },
        "claudeStudio.upload.allowSelfSignedCertificates": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "FTPS only: accept self-signed TLS certificates. Leave off unless your host requires it.",
          "scope": "machine"
        },
        "claudeStudio.usage.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Track Claude Code token usage and cost from the local logs."
        },
        "claudeStudio.usage.statusBar": {
          "type": "string",
          "default": "both",
          "markdownDescription": "What the usage status bar item shows.",
          "enum": [
            "both",
            "percent",
            "cost",
            "off"
          ]
        },
        "claudeStudio.usage.showPlanLimits": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show 5-hour / 7-day plan usage. Sends a tiny 1-token request with your Claude Code login every few minutes while you work.",
          "scope": "machine"
        },
        "claudeStudio.usage.planLimitsIntervalSeconds": {
          "type": "number",
          "default": 300,
          "markdownDescription": "How often plan usage is checked while you are working (seconds).",
          "minimum": 60,
          "maximum": 3600,
          "scope": "machine"
        },
        "claudeStudio.usage.planLimitsModel": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "markdownDescription": "Model used for the 1-token plan usage check.",
          "scope": "machine"
        },
        "claudeStudio.usage.credentialsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom path to Claude Code's `.credentials.json`. Empty = `~/.claude/.credentials.json` (or the macOS Keychain).",
          "scope": "machine"
        },
        "claudeStudio.usage.projectsDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom path to Claude Code's `projects` log folder. Empty = `~/.claude/projects`.",
          "scope": "machine"
        },
        "claudeStudio.usage.refreshSeconds": {
          "type": "number",
          "default": 30,
          "markdownDescription": "How often local usage is re-read (seconds).",
          "minimum": 15,
          "maximum": 600
        },
        "claudeStudio.usage.dailyBudget": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Alert when today's estimated cost reaches 80% and 100% of this amount (USD). `0` = off.",
          "minimum": 0
        },
        "claudeStudio.usage.weeklyBudget": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Alert when the last 7 days' estimated cost reaches 80% and 100% of this amount (USD). `0` = off.",
          "minimum": 0
        },
        "claudeStudio.usage.limitAlertPercent": {
          "type": "number",
          "default": 80,
          "markdownDescription": "Alert when 5h or 7d plan usage reaches this percent.",
          "minimum": 10,
          "maximum": 100
        },
        "claudeStudio.usage.pricing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override prices (USD per million tokens) per model, e.g. `{ \"opus-5-5\": { \"input\": 4, \"output\": 20, \"cacheRead\": 0.2, \"cacheWrite5m\": 5, \"cacheWrite1h\": 8 } }`."
        },
        "claudeStudio.skills.sources": {
          "type": "array",
          "default": [
            {
              "name": "Anthropic official skills",
              "type": "github",
              "repo": "anthropics/skills",
              "path": "skills"
            }
          ],
          "markdownDescription": "Where to browse skills from. Add sources with **Claude Studio: Add Skill Source…**.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "github",
                  "url",
                  "folder"
                ]
              },
              "repo": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "scope": "application"
        },
        "claudeStudio.liveReload.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Reload your local site in the browser after PHP/CSS/JS changes. Run **Claude Studio: Copy Live Reload Script Tag** and paste it into your dev layout."
        },
        "claudeStudio.liveReload.port": {
          "type": "number",
          "default": 35730,
          "markdownDescription": "Port for the live reload server (listens on 127.0.0.1 only).",
          "minimum": 1024,
          "maximum": 65535
        },
        "claudeStudio.liveReload.watch": {
          "type": "array",
          "default": [
            "**/*.{php,html,css,js}"
          ],
          "markdownDescription": "Files that trigger a reload.",
          "items": {
            "type": "string"
          }
        },
        "claudeStudio.liveReload.delayMs": {
          "type": "number",
          "default": 400,
          "markdownDescription": "Wait this long after the last change before reloading.",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.vscode/sftp.json",
        "url": "./schemas/sftp.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --target=node18 --format=cjs --main-fields=module,main --external:vscode --external:cpu-features --external:*.node --minify --keep-names --sourcemap=external --legal-comments=none --outfile=dist/extension.js && node scripts/notices.js",
    "vscode:prepublish": "npm run build",
    "test": "node test/run.js && node test/activate.js && npm run build && node test/activate.js dist && node test/livereload.js && node test/sftp-integration.js && node test/ftp-integration.js",
    "package": "vsce package"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ftp-srv": "^4.6.3",
    "ovsx": "^1.3.0"
  }
}
